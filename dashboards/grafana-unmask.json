{
  "annotations": {
    "list": []
  },
  "description": "unmask: JA4 bot challenge metrics (= /unmask/metrics scrape).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "schemaVersion": 39,
  "tags": ["unmask", "bot", "ja4"],
  "title": "unmask — bot challenge",
  "uid": "unmask-overview",
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "default", "value": "default" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 107,
      "type": "stat",
      "title": "database",
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "min(unmask_db_up)", "legendFormat": "database"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "mappings": [{"type": "value", "options": {"1": {"text": "connected", "color": "green", "index": 0}, "0": {"text": "NO DATABASE", "color": "red", "index": 1}}}]
        }
      },
      "description": "0 while a daemon runs without its database: its start could not open it.  Challenge pages are served; statistics, new bans and the admin UI wait.  On an install that is set up the daemon retries and starts over by itself when the database answers; its log names the error, and `/unmask/readyz` answers 503 meanwhile."
    },
    {
      "id": 101,
      "type": "stat",
      "title": "module fail-safe",
      "gridPos": {"h": 4, "w": 4, "x": 3, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "max(unmask_native_failsafe_active)", "legendFormat": "fail-safe"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "mappings": [{"type": "value", "options": {"0": {"text": "module loaded", "color": "green", "index": 0}, "1": {"text": "FAIL-SAFE: protection off", "color": "red", "index": 1}}}]
        }
      },
      "description": "1 while the plugin's fail-safe has the nginx module stripped and the configuration rendered without it: nginx runs, unmask protects nothing.  `unmask doctor` says why."
    },
    {
      "id": 102,
      "type": "stat",
      "title": "nginx configuration",
      "gridPos": {"h": 4, "w": 4, "x": 7, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "max(unmask_nginx_config_stale)", "legendFormat": "stale"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]},
          "mappings": [{"type": "value", "options": {"0": {"text": "current", "color": "green", "index": 0}, "1": {"text": "reload needed", "color": "orange", "index": 1}}}]
        }
      },
      "description": "1 while a rendered configuration waits for nginx to reload (or restart, when the module changed).  Cleared once the access log shows nginx running it."
    },
    {
      "id": 103,
      "type": "stat",
      "title": "ban list readable by nginx",
      "gridPos": {"h": 4, "w": 4, "x": 11, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "min(unmask_ban_file_worker_readable)", "legendFormat": "readable"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]},
          "mappings": [{"type": "value", "options": {"1": {"text": "readable", "color": "green", "index": 0}, "0": {"text": "UNREADABLE: no ban enforced", "color": "red", "index": 1}}}]
        }
      },
      "description": "0 when nginx's worker cannot read the ban list the daemon writes: nginx then enforces no ban.  1 otherwise, including when there is no list yet."
    },
    {
      "id": 104,
      "type": "stat",
      "title": "schema updates waiting",
      "gridPos": {"h": 4, "w": 3, "x": 15, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "max(unmask_schema_update_pending)", "legendFormat": "pending"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]},
          "mappings": [{"type": "value", "options": {"0": {"text": "none", "color": "green", "index": 0}}}]
        }
      },
      "description": "Schema updates left for the operator (an index build that would take long): applied from the admin's notice or with `unmask migrate`."
    },
    {
      "id": 105,
      "type": "stat",
      "title": "events dropped / 1h",
      "gridPos": {"h": 4, "w": 3, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(unmask_events_dropped_total[1h]))", "legendFormat": "dropped"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "mappings": []
        }
      },
      "description": "Events the batch writer dropped at its backlog cap: the database is not keeping up with the challenge volume.  Anything above zero loses hunt rows and statistics."
    },
    {
      "id": 106,
      "type": "stat",
      "title": "access-log lines dropped / 1h",
      "gridPos": {"h": 4, "w": 3, "x": 21, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(unmask_nginxlog_dropped_total[1h]))", "legendFormat": "dropped"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "mappings": []
        }
      },
      "description": "Access-log lines the receiver dropped at a full queue: the daemon saw less traffic than nginx served, so counts, budgets and the reload notice run behind."
    },
    {
      "id": 1,
      "type": "stat",
      "title": "challenge serve / 24h",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(unmask_event_total{phase=\"serve\"}[24h]))",
          "legendFormat": "serve"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }] } } },
      "description": "Challenge and deny pages served in the last 24 hours: the increase of unmask_event_total, which each daemon counts from zero at its start as it writes the rows, summed over the daemons scraped."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "challenges passed / 24h",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(unmask_event_total{phase=~\"bv_pow_only|bv_captcha_only|bv_pow_then_captcha\"}[24h]))",
          "legendFormat": "passed"
        }
      ],
      "description": "Passes issued in the last 24 hours: a pass is recorded under the phase of the chain that earned it (bv_pow_only, bv_captcha_only, bv_pow_then_captcha)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "verify ng / 24h",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(unmask_event_total{phase=\"verify_ng\"}[24h]))",
          "legendFormat": "verify_ng"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red" }] } } },
      "description": "CAPTCHA answers refused in the last 24 hours."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "unique source IPs (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "unmask_event_unique_ip",
          "legendFormat": "unique IPs"
        }
      ],
      "description": "Distinct addresses behind the last 24 hours of events: an estimate (within a few percent) read from the database's hourly rollup, so daemons that share a database export the same figure.  No value while a daemon has no database or its rollup has not completed its first pass."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "challenge funnel (rate / 5m)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (rate(unmask_event_total[5m]))",
          "legendFormat": "{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineInterpolation": "smooth", "fillOpacity": 12 },
          "unit": "ops"
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] } }
    },
    {
      "id": 20,
      "type": "barchart",
      "title": "verdict distribution (24h, top 12)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (verdict) (increase(unmask_event_total[24h])))",
          "legendFormat": "{{verdict}}",
          "instant": true
        }
      ]
    },
    {
      "id": 21,
      "type": "heatmap",
      "title": "verify score histogram",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(unmask_verify_score_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": { "yAxis": { "unit": "short" } }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "exporter's database reads: average time per op",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(unmask_db_query_seconds_sum[5m])) / sum by (op) (rate(unmask_db_query_seconds_count[5m]))",
          "legendFormat": "avg {{op}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineInterpolation": "smooth", "fillOpacity": 8 } }
      },
      "description": "unmask_db_query_seconds is a summary with a sum and a count per op and no quantiles, so this is the average: seconds spent divided by reads.  The one op the exporter times is its read of the unique-address sketches (metrics_unique_ip), once a minute at most; the event counter is counted in memory and reads nothing."
    }
  ]
}
