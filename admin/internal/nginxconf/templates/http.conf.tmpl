# =============================================================================
# unmask: nginx http {} scope (= auto-generated by `unmask render-nginx`)
# =============================================================================
#
#  DO NOT EDIT THIS FILE.  It is regenerated from /etc/unmask/config.yml every
#  time `unmask render-nginx` runs.  Edit config.yml instead.
#
#  generated_at: {{ .GeneratedAt }}
#  unmask_version: {{ .Version }}
#
#  Place this in your nginx http {} block:
#
#      http {
#          include {{ .OutputDir }}/http.inc;
#          ...
#      }
#
#  Also load the ja4 module separately (main scope):
#      load_module /usr/lib/nginx/modules/ngx_http_unmask_module.so;

# -----------------------------------------------------------------------------
# Map hash sizing for the community-bans maps.  The widest key is the ipja4
# "<ip>:<ja4>" pair -- up to ~76 chars with an IPv6 address, which overflows the
# default map_hash_bucket_size (= ngx_cacheline_size, 64 on x86_64 / aarch64);
# a large feed also exceeds the default map_hash_max_size (2048).  Both are
# single-occurrence http{} directives that must precede the map blocks they size
# (nginx builds the map hash at parse time), so they are emitted HERE at the top
# of http.inc -- which sits above every map below -- not in nginx.conf.  They are
# emitted only when (a) community-bans enforcement is active and (b) the host
# nginx.conf does not already declare that directive (a duplicate is a fatal
# `nginx -t` error); buildRenderData probes nginx.conf and warns when a host
# value is present but smaller than 256.
# -----------------------------------------------------------------------------
{{- if .CommunityBansMapHashBucket }}
map_hash_bucket_size 256;  # unmask: community-bans ipja4 keys reach ~76 chars (IPv6)
{{- end }}
{{- if .CommunityBansMapHashMax }}
map_hash_max_size 4096;    # unmask: community-bans feed can exceed the 2048 default
{{- end }}
{{- if .EmitVariablesHash }}
# unmask's maps (rate-limit / per-site / challenge axes) push the variable count
# past nginx's 1024 default, so nginx warns "could not build optimal
# variables_hash" on every reload.  Size it up.  Skipped when the host
# nginx.conf already declares either directive (a duplicate is fatal).
variables_hash_max_size 2048;
variables_hash_bucket_size 128;
{{- end }}

# -----------------------------------------------------------------------------
# unmask module main directives (secret + cookie validity period + ban file)
# -----------------------------------------------------------------------------
unmask_bv_secret                "{{ .BVSecret }}";
unmask_bv_pow_valid_seconds     {{ .BVPowValidSeconds }};
unmask_bv_captcha_valid_seconds {{ .BVCaptchaValidSeconds }};
unmask_bv_pow_difficulty        {{ .PowDifficulty }};
{{- if .BanFilePath }}
unmask_ban_file "{{ .BanFilePath }}";
{{- end }}

# -----------------------------------------------------------------------------
# Forwarded scheme / port for the admin upstream
# -----------------------------------------------------------------------------
# server.inc forwards X-Forwarded-Proto / X-Forwarded-Port to the admin
# upstream so the hunt page can build https://host:port/path links.  When TLS
# terminates on this nginx the local $scheme / $server_port are correct; when
# an LB / CDN terminated TLS and forwarded the visitor, this nginx is on plain
# http and $scheme would always be "http".  Map prefers the upstream header
# (= the LB knows what the visitor used) and falls back to the local value.
# Empty / non-http(s) header values fall back too, so a malformed input never
# ends up in the recorded URL.
map $http_x_forwarded_proto $unmask_forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}
map $http_x_forwarded_port $unmask_forwarded_port {
    default       $server_port;
    "~^[1-9][0-9]{0,4}$" $http_x_forwarded_port;
}

# -----------------------------------------------------------------------------
# Search / AI / Ads bot UA — exempt from challenge (avoid ranking accidents)
# -----------------------------------------------------------------------------
{{- if gt .RangeVerifiedUACount 0 }}
# Note: {{ .RangeVerifiedUACount }} crawler UA patterns (Googlebot, bingbot, GPTBot, ...) are
# deliberately NOT listed here.  Their vendors publish official IP ranges and
# the matching range presets are enabled, so those crawlers are rescued by
# geo $is_bypass_ip below instead — a spoofed UA from outside the published
# ranges is challenged like any other client.
{{- end }}
map $http_user_agent $is_search_bot {
    default 0;
{{- range .SearchBotPatterns }}
    "~*{{ . }}" 1;
{{- end }}
}

# -----------------------------------------------------------------------------
# Bypass IP allowlist (trusted IP / CIDR exempt from challenge / rate_limit)
# -----------------------------------------------------------------------------
# IPs registered in the web settings UI (trusted crawlers / monitoring / internal
# LBs etc.) expand here.  default 0 (every access is non-bypass).
geo $is_bypass_ip {
    default 0;
{{- range .BypassIPs }}
    {{ . }} 1;
{{- end }}
{{- range .StatsExcludeIPs }}
    {{ . }} 1;
{{- end }}
}

# -----------------------------------------------------------------------------
# Statistics exclusion ($unmask_stats_excluded / $unmask_log_keep)
# -----------------------------------------------------------------------------
# IPs in nginx.stats_exclude_ips (own monitoring tools / internal probes that
# would otherwise be dashboard noise) are dropped entirely from statistics:
# $unmask_log_keep gates the unmask_minimal access_log via `if=`, so these
# requests never reach the funnel / cookie / crawler aggregation.  The same IPs
# are folded into $is_bypass_ip above, so no challenge fires for them either.
geo $unmask_stats_excluded {
    default 0;
{{- range .StatsExcludeIPs }}
    {{ . }} 1;
{{- end }}
}
map $unmask_stats_excluded $unmask_log_keep {
    default 1;
    "1"     0;
}

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Trusted LB IP -> vendor name -> JA4 header chain.
# Presets (lb_iprange.go) define per-vendor IP ranges and header names.  The
# user can leave the server block empty: requests via a trusted LB get the
# correct header value into $effective_ja4.  Direct access (non-LB) ignores
# the header and falls back to the native module's $client_ja4 — safe default.
# -----------------------------------------------------------------------------

# 1) source IP -> vendor name.  Non-LB IPs get "" (header ignored).
# Evaluated using $realip_remote_addr (= the original IP before
# ngx_http_realip_module's set_real_ip_from / real_ip_header X-Forwarded-For
# rewrites $remote_addr to the visitor IP).  Requests forwarded from an LB
# have an original IP within the LB's range, get vendor-classified, and the
# header is trusted.  In environments not using realip module,
# $realip_remote_addr is empty and falls back to default "" — safe, same as
# legacy behavior.
geo $realip_remote_addr $unmask_lb_vendor {
    default "";
{{- range $g := .LBIPRanges }}
{{- if $g.CIDRs }}

    # {{ $g.Label }} ({{ $g.Source }})
{{- range $g.CIDRs }}
    {{ . }} "{{ $g.ID }}";
{{- end }}
{{- end }}
{{- end }}
}

# 2) vendor name -> the JA4 header value for that vendor.  default is "" (outside trusted LB).
map $unmask_lb_vendor $unmask_lb_ja4 {
    default "";
{{- range .LBIPRanges }}
{{- if .CIDRs }}
    "{{ .ID }}" {{ .Header }};
{{- end }}
{{- end }}
}

# 3) Diagnostic: matrix of "LB classified" vs "LB header received".  No behavior
#    impact (used only by log output).  Lets log_format pinpoint, at a glance,
#    why ja4 ended up empty.  Values:
#      ok                  : normal (header adopted from trusted LB / or no LB present)
#      untrusted_lb_header : header arrived but source IP isn't a trusted LB
#                            (e.g. real_ip module rewrote $remote_addr to the
#                            visitor IP and the geo block's trust IP check
#                            missed — sign of a misconfiguration)
#      trusted_no_header   : classified as trusted LB but header value is empty
#                            (LB isn't sending the header)
#    Adding `diag=$ja4_diag` to log_format makes "header came but wasn't used"
#    immediately visible as ja4 empty + diag=untrusted_lb_header.
map "{{- range $i, $g := .LBIPRanges -}}{{ $g.Header }}{{- end -}}" $unmask_any_lb_header {
    default 1;
    ""      0;
}
map "$unmask_lb_vendor:$unmask_any_lb_header" $ja4_diag {
    default                 "ok";
    "~^:1$"                 "untrusted_lb_header";
    "~^[^:]+:0$"            "trusted_no_header";
}

# 4) JA4 fingerprint -> verdict
# Priority: $unmask_lb_ja4 (header via trusted LB) > $client_ja4 (module self-computed)
#
# When the vendor is not classified but an LB header is present (i.e.
# ja4_diag=untrusted_lb_header), flow the sentinel value "NOT_TRUSTED" into
# $effective_ja4.  This way:
#   - NOT_TRUSTED appears in log / dashboard / events.JA4 columns —
#     trust-path mistakes are immediately visible.
#   - In the ja4_verdict / ja4_action maps NOT_TRUSTED doesn't match any preset
#     pattern, so it falls to default "ok" — no side effect on the challenge
#     trigger logic (same as legacy behavior).
#   - If aggregations / charts show NOT_TRUSTED counts, it's a signal to
#     "verify trust LB settings / real_ip module ordering / etc".
map $ja4_diag $unmask_lb_ja4_or_sentinel {
    "untrusted_lb_header" "NOT_TRUSTED";
    default               $unmask_lb_ja4;
}
map $unmask_lb_ja4_or_sentinel $effective_ja4 {
    ""      $client_ja4;
    default $unmask_lb_ja4_or_sentinel;
}

# JA4 -> verdict label (free-form label for log / dashboard display).  No behavior impact.
map $effective_ja4 $ja4_verdict {
    default "ok";
{{- range .JA4Verdicts }}
    "~^{{ .Pattern }}" "{{ .Verdict }}";
{{- end }}
}

# JA4 -> action enum ("bot" | "suspect" | "ok").  This determines behavior.
#   bot     : challenge HTML skips PoW -> directly to CAPTCHA
#   suspect : flow proceeds normally (log-only observation)
#   ok      : not a challenge target
map $effective_ja4 $ja4_action {
    default "ok";
{{- range .JA4Verdicts }}
    "~^{{ .Pattern }}" "{{ .Action }}";
{{- end }}
}

# Treat as a challenge HIT only when action == bot.
map $ja4_action $ja4_hit_flag {
    default "0";
    "bot"   "1";
}

# -----------------------------------------------------------------------------
# Challenge-target UA decision ($is_challenge_target)
# -----------------------------------------------------------------------------
# When a bot signal fires (JA4 action=bot/suspect / honeypot), should this UA
# be challenged?  Generalization of the old `$is_known_browser`.
# Controlled by config.yml's nginx.challenge_targets:
#   all = true  -> always a target regardless of UA (every access is a candidate)
#   all = false -> only UAs matching a preset group + extra are targeted
{{- if .ChallengeAll }}
map $http_user_agent $is_challenge_target {
    default 1;
}
{{- else }}
map $http_user_agent $is_challenge_target {
    default 0;
{{- range .ChallengeTargetPatterns }}
    "~*{{ . }}" 1;
{{- end }}
}
{{- end }}

# -----------------------------------------------------------------------------
# Global axis: no-match action ($is_known_browser → action → should-challenge)
# -----------------------------------------------------------------------------
# When none of the upstream axes (search bot rescue / bypass / protected /
# challenge-target UA blacklist) match, the request falls into the "no-match"
# bucket.  unmask's Operating mode tab splits that bucket by UA shape:
#
#   $is_known_browser=1  → Chrome / Safari / Firefox / Edge / Opera UA prefix
#   $is_known_browser=0  → everything else (= curl / library / unknown SaaS)
#
# A per-bucket action (pow_only / pow_then_captcha / captcha_only / pass /
# deny) is rendered into $unmatched_chain_action below.  Whether to actually
# fire the challenge is just "action != pass".  The chain itself is picked
# admin-side from window.UNMASK.challenge_mode.
map $http_user_agent $is_known_browser {
    default 0;
    "~^Mozilla/5\.0\s.*\s(?:Chrome|Safari|Firefox|Edge?)/[0-9]" 1;
    "~^Mozilla/5\.0\s.*\sOPR/[0-9]"                              1;
    "~^Opera/[0-9]"                                              1;
}
map $is_known_browser $unmatched_chain_action {
    default "{{ .UnknownUAAction }}";
    1       "{{ .KnownBrowserAction }}";
}
map $unmatched_chain_action $unmatched_should_challenge {
    default 1;
    "pass"  0;
}

# -----------------------------------------------------------------------------
# bv (bot-verified) cookie classification aliases
# -----------------------------------------------------------------------------
# Provide short aliases for the 3 variables the plugin exposes.
#   $bv_kind          : "captcha" (3-seg HMAC OK) / "pow" (4-seg SHA-256 OK) / ""
#   $bv_captcha_valid : 1 if $bv_kind == "captcha", else 0
#   $bv_pow_valid     : 1 if $bv_kind == "pow", else 0
#   $bv_any_valid     : 1 if any of the above, else 0  ("repeater" check)
#
# Extension: if the plugin adds new kinds (signature / webauthn / passkey etc.)
# a new value appears in $bv_kind -> the admin cookie_minute table (kind/cnt
# normalized) auto-records that kind as one row.
map $unmask_bv_kind $bv_kind          { default $unmask_bv_kind; }
map $unmask_bv_kind $bv_captcha_valid { default 0;  "captcha" 1; }
map $unmask_bv_kind $bv_pow_valid     { default 0;  "pow"     1; }
map $unmask_bv_kind $bv_any_valid     { default 1;  ""        0; }

# -----------------------------------------------------------------------------
# $unmask_chmode — challenge-mode hint
# -----------------------------------------------------------------------------
# auth_request/server.inc's @unmask_to_challenge forwards this to
# /unmask/challenge/?chm=<mode>.  In forward-auth mode the value is filled
# per-request by `auth_request_set $unmask_chmode $upstream_http_x_unmask_chmode;`
# (auth_request/protect.inc).  Native mode has no auth_request_set, so without
# a definition here nginx aborts with `unknown "unmask_chmode" variable` the
# moment auth_request/server.inc is included.  Define it (default empty) so the
# shared server.inc parses in both modes; map + auth_request_set coexist on the
# same CHANGEABLE variable, and an empty chm= is ignored by the serve handler
# (= the per-axis chain is chosen instead).
map "" $unmask_chmode { default ""; }

# -----------------------------------------------------------------------------
# Persistent BAN dispatch ($unmask_banned / $unmask_ban_action)
# -----------------------------------------------------------------------------
# The native plugin exposes $unmask_banned (0/1) and $unmask_ban_action
# (= the chain mode written by admin into the ban file: deny / pow_only /
# pow_then_captcha / captcha_only).  server.inc switches on
# $unmask_ban_action_effective so the operator's choice on the bans tab
# (= manual / community_bans) or the honeypot tab takes effect with zero
# hand-written nginx.conf branches.  /unmask/* is masked off so a banned
# visitor can still fetch the challenge HTML and clear the BAN -- without
# this guard the rewrite would loop on each challenge asset request.
map $request_uri $unmask_ban_action_effective {
    default      $unmask_ban_action;
    "~^/unmask/" "";
}
map $request_uri $unmask_banned_effective {
    default      $unmask_banned;
    "~^/unmask/" "0";
}

# -----------------------------------------------------------------------------
# Honeypot path detection ($serve_bot_challenge)
# -----------------------------------------------------------------------------
# Detects access to trap paths registered in unmask settings.  On match, the
# nginx access_log hp=1 routes through admin, which adds IP+JA4 to the
# persistent BAN list.  Banned visitors get the configured action (= 403 /
# challenge) applied automatically by the BAN dispatch map above.  Per-path
# "force CAPTCHA / PoW" is a separate feature ("protected paths").
#
# Per-host honeypots go through the four-stage layout (= same as Bypass /
# Protected): global path map + per-host path maps + host dispatcher + OR
# merge.

# Stage A: global rules (= rule.Site == "").  Applied to every host.
map $request_uri $unmask_hp_global {
    default "0";
{{- range .HoneypotPatternsGlobal }}
    "~*{{ . }}" "1";
{{- end }}
}

{{- if .HoneypotPatternsPerHost }}

# Stage B: per-host rules.  One map per unique host string.
{{- range .HoneypotPatternsPerHost }}
map $request_uri $unmask_hp_host_{{ .VarName }} {
    default "0";
{{- range .Patterns }}
    "~*{{ . }}" "1";
{{- end }}
}
{{- end }}

# Stage C: host dispatcher.  Pins to "0" for unknown hosts so they fall
# through to global cleanly.
map $host $unmask_hp_per_host {
    default "0";
{{- range .HoneypotPatternsPerHost }}
    "{{ .Host }}" $unmask_hp_host_{{ .VarName }};
{{- end }}
}

# Stage D: OR-combine global + per-host into the canonical signal.
map "$unmask_hp_global$unmask_hp_per_host" $serve_bot_challenge {
    default "0";
    "~1" "1";
}
{{- else }}

# No per-host rules configured -- global map is the canonical signal directly.
map $unmask_hp_global $serve_bot_challenge {
    default "0";
    "1" "1";
}
{{- end }}

# Honeypot trip URI: carry $request_uri into the access log ONLY when a honeypot
# path matched ($serve_bot_challenge=1), so a native-mode ban can record which
# trap URL it came from.  Empty for every normal request -- keeps the
# high-volume unmask_minimal access-log line lean.
map $serve_bot_challenge $unmask_hp_uri {
    default "";
    "1"     $request_uri;
}

# -----------------------------------------------------------------------------
# Protected paths ($protected_mode)
# -----------------------------------------------------------------------------
# Force CAPTCHA / PoW / strict on specific paths (admin panel / critical form /
# API key entry etc.).  Difference from honeypot: "visitors reaching this path
# are confirmed human".  Affects only that path, no spillover.
#   - captcha : skip PoW -> CAPTCHA directly -> _bv (default; medium UX)
#   - pow     : issue _bv with PoW only (lightweight)
#   - strict  : PoW -> CAPTCHA chain (in v0.1 equivalent to captcha; chained in v0.2)
#
# Per-host rules go through the same four-stage pattern as Bypass paths:
# stage A emits the global path map, stage B emits one path map per unique
# Site, stage C dispatches by $host, and stage D picks per-host first with
# fall-back to global (= map values can reference variables in nginx so the
# dispatcher reads through to the actual per-host map's result).

# Stage A: global rules (= rule.Site == "").  Applied to every host.
map $request_uri $unmask_pp_global {
    default "";
{{- range .ProtectedPathsGlobal }}
    "~*{{ .Pattern }}" "{{ .Mode }}";
{{- end }}
}

{{- if .ProtectedPathsPerHost }}

# Stage B: per-host rules.  One map per unique host string; the value is the
# protected mode literal so per-host rules can carry a different mode than
# the global pattern would.
{{- range .ProtectedPathsPerHost }}
map $request_uri $unmask_pp_host_{{ .VarName }} {
    default "";
{{- range .Rules }}
    "~*{{ .Pattern }}" "{{ .Mode }}";
{{- end }}
}
{{- end }}

# Stage C: host dispatcher.  Selects the per-host map's value for the
# current $host; unknown hosts pin to "" so they fall through to global.
map $host $unmask_pp_per_host {
    default "";
{{- range .ProtectedPathsPerHost }}
    "{{ .Host }}" $unmask_pp_host_{{ .VarName }};
{{- end }}
}

# Stage D: per-host wins.  Empty per-host result -> use global.
map $unmask_pp_per_host $protected_mode {
    default $unmask_pp_global;
    "captcha" "captcha";
    "pow"     "pow";
    "strict"  "strict";
}
{{- else }}

# No per-host rules configured -- global map is the canonical signal directly.
map $unmask_pp_global $protected_mode {
    default "";
    "captcha" "captcha";
    "pow"     "pow";
    "strict"  "strict";
}
{{- end }}

{{- if .CommunityBansSubscribe }}
# A community bans hit is treated equivalently to protected_mode=captcha (forced
# CAPTCHA, not a hard block).  If the original protected_mode is explicitly
# set, respect that (site-side conf wins).
map "$community_bans_hit:$protected_mode" $protected_mode_eff {
    default $protected_mode;
    "~^1:$" "captcha";
}
{{- else }}
# community bans subscribe OFF: protected_mode_eff = passthrough of protected_mode.
map $protected_mode $protected_mode_eff {
    default $protected_mode;
}
{{- end }}

# -----------------------------------------------------------------------------
# Country-based decision ($unmask_country / $unmask_geo_action)
# -----------------------------------------------------------------------------
# Materialised at render time from the operator-configured mmdb (DB-IP /
# GeoLite2 / etc.).  Only CIDRs whose ISO country code appears in
# Geo.Rules.Enabled are emitted, so the geo block stays small even with
# a 6 MB mmdb.  Native plugin mode reads $unmask_country / $unmask_geo_action
# from these maps without needing libmaxminddb at runtime.
# forward-auth mode keeps doing live mmdb lookups via admin /authcheck.
#
# Actions: skip / pow_only / captcha_only / pow_then_captcha / deny.
# "skip" (= the no-op default) is named skip rather than pass so operators
# don't read it as "allow"; the request continues through the remaining
# decision axes unchanged.
geo $remote_addr $unmask_country {
    default "";
{{ .GeoCIDRs }}
}

map $unmask_country $unmask_geo_action {
    default "{{ .GeoDefaultAction }}";
{{- range .GeoRules }}
    "{{ .Country }}" "{{ .Action }}";
{{- end }}
}

# Binary form used by $final_challenge.  skip / empty -> 0, everything else
# (= challenge actions + deny) -> 1.  chMode resolution (= which screen) is
# handled admin-side based on the original $unmask_geo_action value.
map $unmask_geo_action $is_geo_challenge {
    default 1;
    ""      0;
    "skip"  0;
}

# -----------------------------------------------------------------------------
# ASN-based decision ($unmask_asn / $unmask_asn_action) — the by-network
# sibling of the country block above.  Blocks a cloud/VPS/proxy network without
# blocking a whole country.  Only CIDRs of the operator's targeted ASNs are
# emitted (walked from the ASN mmdb at render time), so the block stays small.
# Empty when no ASN rules exist or the ASN mmdb is absent -> the axis no-ops.
# forward-auth mode does the live ASN lookup in admin /authcheck (asnDecide).
geo $remote_addr $unmask_asn {
    default "";
{{ .AsnCIDRs }}
}

map $unmask_asn $unmask_asn_action {
    default "{{ .AsnDefaultAction }}";
{{- range .AsnRules }}
    "{{ .Key }}" "{{ .Action }}";
{{- end }}
}

map $unmask_asn_action $is_asn_challenge {
    default 1;
    ""      0;
    "skip"  0;
}

# -----------------------------------------------------------------------------
# Per-axis exempt paths ($is_geo_exempt_path / $is_asn_exempt_path)
# -----------------------------------------------------------------------------
# Scope: a matching request skips ONE axis only -- geo-exempt paths skip the
# country decision, asn-exempt paths skip the ASN decision.  Everything else
# (the other axis, ja4 verdict / honeypot / protected paths / UA filter / rate
# limit / ban) still runs -- unlike $is_bypass_path, which vetoes EVERY
# judgment.  For endpoints that legitimately draw datacenter or overseas bots:
# RSS/Atom feeds pulled by Feedly / Inoreader from AWS/GCP IPs that a country
# or ASN policy would otherwise sweep up.  Same $request_uri-keyed convention
# as bypass paths: path-anchored regex used verbatim, per-host rules via a
# $host dispatcher.
map $request_uri $unmask_gx_global {
    default "0";
{{- range .GeoExemptPathsGlobal }}
    "~{{ . }}" "1";
{{- end }}
}
{{- if .GeoExemptPathsPerHost }}
{{- range .GeoExemptPathsPerHost }}
map $request_uri $unmask_gx_host_{{ .VarName }} {
    default "0";
{{- range .Patterns }}
    "~{{ . }}" "1";
{{- end }}
}
{{- end }}
map $host $unmask_gx_per_host {
    default "0";
{{- range .GeoExemptPathsPerHost }}
    "{{ .Host }}" $unmask_gx_host_{{ .VarName }};
{{- end }}
}
map "$unmask_gx_global$unmask_gx_per_host" $is_geo_exempt_path {
    default "0";
    "~1" "1";
}
{{- else }}
map $unmask_gx_global $is_geo_exempt_path {
    default "0";
    "1" "1";
}
{{- end }}

map $request_uri $unmask_ax_global {
    default "0";
{{- range .AsnExemptPathsGlobal }}
    "~{{ . }}" "1";
{{- end }}
}
{{- if .AsnExemptPathsPerHost }}
{{- range .AsnExemptPathsPerHost }}
map $request_uri $unmask_ax_host_{{ .VarName }} {
    default "0";
{{- range .Patterns }}
    "~{{ . }}" "1";
{{- end }}
}
{{- end }}
map $host $unmask_ax_per_host {
    default "0";
{{- range .AsnExemptPathsPerHost }}
    "{{ .Host }}" $unmask_ax_host_{{ .VarName }};
{{- end }}
}
map "$unmask_ax_global$unmask_ax_per_host" $is_asn_exempt_path {
    default "0";
    "~1" "1";
}
{{- else }}
map $unmask_ax_global $is_asn_exempt_path {
    default "0";
    "1" "1";
}
{{- end }}

# Effective per-axis verdicts: each axis fires only when it votes AND its own
# exempt-path list does not match.
map "$is_geo_challenge:$is_geo_exempt_path" $geo_challenge_eff {
    default 1;
    "~^0:"  0;  # country axis not firing
    "~:1$"  0;  # path exempted from the country axis
}
map "$is_asn_challenge:$is_asn_exempt_path" $asn_challenge_eff {
    default 1;
    "~^0:"  0;  # ASN axis not firing
    "~:1$"  0;  # path exempted from the ASN axis
}

# Network-level veto = geo OR asn (each after its own path exemption).  Folded
# into one variable so it drops into the existing $final_challenge composite
# key at the geo position without widening it.  The other $final_challenge
# fields (ja4 / honeypot / protected / UA) are untouched by the exemptions.
map "$geo_challenge_eff:$asn_challenge_eff" $is_net_challenge {
    default 1;
    "0:0"   0;
}

{{- if .CommunityBansSubscribe }}

# -----------------------------------------------------------------------------
# Community Bans (unmask.sh community).  Forced CAPTCHA on hit (no hard block).
# -----------------------------------------------------------------------------
# unmask periodically pulls the aggregation hub
# (https://unmask.sh/feed.json) and writes 3 map snippets
# ({{ .CommunityBansMapDir }}/community-bans-{ipja4,ja4,ip}.map).  Entries are
# classified server-side (unmask.sh) into 3 match types:
#   ip_ja4 : matches "specific IP AND specific JA4" only (strictest)
#   ja4_only: matches "any IP with the specific JA4" (mass JA4-budget bots)
#   ip_only: matches "all traffic from the specific IP" (all JA4 from a bad host)
# Each map is generated empty by unmask when missing, so include always succeeds.

map "$remote_addr:$effective_ja4" $community_bans_hit_ipja4 {
    default 0;
    include {{ .CommunityBansMapDir }}/community-bans-ipja4.map;
}
map $effective_ja4 $community_bans_hit_ja4 {
    default 0;
    include {{ .CommunityBansMapDir }}/community-bans-ja4.map;
}
map $remote_addr $community_bans_hit_ip {
    default 0;
    include {{ .CommunityBansMapDir }}/community-bans-ip.map;
}
# 1 if any of them hits.
map "$community_bans_hit_ipja4$community_bans_hit_ja4$community_bans_hit_ip" $community_bans_hit {
    default 0;
    "~1" 1;
}
{{- end }}

# -----------------------------------------------------------------------------
# Bypass paths ($is_bypass_path) — per-path passthrough out of all unmask judgments
# -----------------------------------------------------------------------------
# Scope: matching access is exempted from JA4 verdict / honeypot / protected
# paths / rate limit.  Useful for "the whole site is under unmask, but
# static / api pass through".
#
# Design: every path map is keyed on `$request_uri` alone -- never a
# host-prefixed concatenation.  This lets operators write path-anchored
# regex (`^/api/`) literally without worrying about a second `^` landing
# mid-string.  Per-host rules go through a host dispatcher map that selects
# which per-host map's result to surface.
#
# Stage A: global rules (= rule.Site == "").  Applied to every host.
map $request_uri $unmask_bp_global {
    default "0";
{{- range .BypassPathsGlobal }}
    "~{{ . }}" "1";
{{- end }}
}

{{- if .BypassPathsPerHost }}

# Stage B: per-host rules.  One map per unique host string; pattern stays in
# the same path-anchored form because the map is keyed on $request_uri.
{{- range .BypassPathsPerHost }}
map $request_uri $unmask_bp_host_{{ .VarName }} {
    default "0";
{{- range .Patterns }}
    "~{{ . }}" "1";
{{- end }}
}
{{- end }}

# Stage C: host dispatcher.  Selects the per-host map's value for the
# current $host; unknown hosts pin to "0" so they fall through to global.
map $host $unmask_bp_per_host {
    default "0";
{{- range .BypassPathsPerHost }}
    "{{ .Host }}" $unmask_bp_host_{{ .VarName }};
{{- end }}
}

# Stage D: OR-combine global + per-host into the canonical signal.
map "$unmask_bp_global$unmask_bp_per_host" $is_bypass_path {
    default "0";
    "~1" "1";
}
{{- else }}

# No per-host rules configured -- global map is the canonical signal directly.
map $unmask_bp_global $is_bypass_path {
    default "0";
    "1" "1";
}
{{- end }}

# -----------------------------------------------------------------------------
# $final_challenge — final decision on whether to trigger challenge
# -----------------------------------------------------------------------------
# 9 input signals:
#   bv_any_valid : is_search_bot : is_bypass_ip : is_bypass_path : is_net_challenge : protected_mode : is_challenge_target : ja4_action : serve_bot_challenge
#
# Decision priority:
#   1. bv_any_valid=1                 -> exempt (already carries CAPTCHA / PoW pass cookie)
#   2. is_search_bot / is_bypass_ip   -> exempt (Googlebot accident prevention / trusted IP)
#   3. is_bypass_path=1               -> exempt (bypass path)
#   4. is_net_challenge=1             -> challenge (country OR asn veto; chMode picked by admin)
#   5. protected_mode != ""           -> challenge (UA-agnostic; admin-panel gate)
#   6. is_challenge_target=0          -> exempt (CLI / library; matches ua-filter whitelist)
#   7. is_challenge_target=1          -> challenge (matches ua-filter blacklist;
#                                         fires regardless of ja4_action (ok /
#                                         unknown / bot) and honeypot presence.
#                                         "matches blacklist = must clear PoW"
#                                         is unmask's intrinsic behavior; the
#                                         "skip PoW -> straight to CAPTCHA"
#                                         decision is made by separate logic
#                                         based on ja4 bot classification.)
map "$bv_any_valid:$is_search_bot:$is_bypass_ip:$is_bypass_path:$is_net_challenge:$protected_mode_eff:$is_challenge_target:$ja4_action:$serve_bot_challenge" {{ if or .StaleBrowserEnabled .HeaderIntegrityEnabled }}$final_challenge_base{{ else }}$final_challenge{{ end }} {
    default 0;
    "~^1:"                      0;  # _bv valid (CAPTCHA or PoW pass) -> exempt
    "~^0:1:"                    0;  # search bot UA -> exempt
    "~^0:0:1:"                  0;  # bypass IP -> exempt
    "~^0:0:0:1:"                0;  # bypass path -> exempt
    "~^0:0:0:0:1:"              1;  # country rule (deny / chain) -> challenge
    "~^0:0:0:0:0:captcha:"      1;  # protected path (UA-agnostic)
    "~^0:0:0:0:0:pow:"          1;
    "~^0:0:0:0:0:strict:"       1;
    "~^0:0:0:0:0::1:"           1;  # target UA -> always challenge (regardless of ja4 / honeypot)
    "~^0:0:0:0:0::0:[^:]*:1$"   1;  # honeypot trip (= $serve_bot_challenge=1) -> always challenge
    "~^0:0:0:0:0::0:"           $unmatched_should_challenge;  # fall back to Global axis (known vs unknown UA)
}
{{- if .StaleBrowserEnabled }}

# -----------------------------------------------------------------------------
# Stale-browser tier (Global.StaleBrowserEnabled)
# -----------------------------------------------------------------------------
# A UA advertising a Chromium-family major far behind current stable is a
# distributed-scraper tell (the 2026-07-15 uic.io incident pinned Chrome/139
# while stable was 150 and solved the transparent PoW headlessly across ~4k
# residential-proxy IPs).  $unmask_stale_browser matches that UA shape; the
# combiner below escalates the base decision to a challenge for it — but ONLY
# when the request was not already exempted (a bypass IP / bypass path / search
# bot / valid _bv keeps its pass), so monitoring probes and genuine crawlers
# are untouched.  The challenge SCREEN (CAPTCHA vs PoW) is chosen daemon-side
# in ServeChallenge / uaDecide so a headless PoW-solver hits the CAPTCHA wall.
map $http_user_agent $unmask_stale_browser {
    default 0;
    "~{{ .StaleBrowserPattern }}" 1;
}
# Escalate only a not-otherwise-exempt, would-pass request (base=0) that is
# stale.  Key: base : stale : search_bot : bypass_ip : bypass_path : bv_valid.
# When the header-integrity tier also runs it consumes this result next, so
# emit into an intermediate; otherwise this IS the final decision.
map "$final_challenge_base:$unmask_stale_browser:$is_search_bot:$is_bypass_ip:$is_bypass_path:$bv_any_valid" {{ if .HeaderIntegrityEnabled }}$fc_after_stale{{ else }}$final_challenge{{ end }} {
    default              $final_challenge_base;  # keep base decision (incl. all base=1 challenges)
    "~^0:1:0:0:0:0$"     1;                       # stale + no exemption + would-pass -> challenge
}
{{- end }}
{{- if .HeaderIntegrityEnabled }}

# -----------------------------------------------------------------------------
# Header-integrity tier (Global.HeaderIntegrity)
# -----------------------------------------------------------------------------
# A UA advertising a Chromium-family browser, over https on h2/h3, that carries
# no Sec-CH-UA is a spoof tell (a real Chromium sends client hints in that
# context).  All preconditions must hold -- the axis is silent on http, h1,
# Firefox/Safari, and TLS-intercept proxies that strip the header over http --
# so it never fires on the populations that legitimately lack it.  Like the
# stale tier it only ESCALATES a not-otherwise-exempt, would-pass request; the
# challenge SCREEN is clamped to CAPTCHA daemon-side (never deny).
map $http_user_agent $unmask_ua_chromium {
    default 0;
    # Chrome / Edge / Opera / Brave / Chromium all carry Chrome/<major>, but the
    # axis only has an opinion from major 89 up: Sec-CH-UA shipped in Chromium 89
    # (2021-03), so on anything older the header is legitimately absent and
    # firing on it charges genuine old browsers for something they cannot fix.
    # A valid _bv cookie still passes them ($bv_any_valid in $final_challenge
    # below), so this was never a permanent lockout -- but the tell never goes
    # away, so the same visitor is asked again every time that cookie lapses.
    # Matches 89, 90-99 and any 3+ digit major; the trailing (\.|$) anchors the
    # major so "Chrome/8" never reads as 89.  Mirrors classify.SecCHUAMinChromeMajor.
    # (Written without {n,} braces: nginx parses those specially in a map.)
    "~(?i)Chrome/(?:89|9[0-9]|[1-9][0-9][0-9]+)(?:\.|$)" 1;
}
# $server_protocol is "HTTP/2.0" / "HTTP/3.0" on those transports and is always
# defined (unlike $http2/$http3, which error when the module isn't loaded).
map $server_protocol $unmask_http_modern {
    default 0;
    "~^HTTP/[23]" 1;
}
{{- if .HeaderIntegrityLBFronted }}
# LB-fronted: a trusted TLS-terminating LB re-originates the backend hop as
# HTTP/1.1, so $scheme / $server_protocol here describe the LB->nginx hop, not
# the visitor -- $unmask_http_modern would be 0 for every request and the axis
# could never fire.  Key off the LB-forwarded scheme ($unmask_forwarded_proto,
# X-Forwarded-Proto-preferred) and treat any LB-forwarded request as a modern
# context: a real Chromium over https still sends Sec-CH-UA regardless of the
# HTTP version, so its absence over https remains the spoof tell.
map $http_x_forwarded_proto $unmask_via_lb {
    default 0;
    "~."    1;   # any non-empty X-Forwarded-Proto = forwarded by the LB
}
# modern context = real h2/h3 (direct) OR LB-forwarded (protocol masked).
map "$unmask_http_modern$unmask_via_lb" $unmask_modern_ctx {
    default 1;   # any "1" present -> modern
    "00"    0;   # neither -> not a modern context
}
# Fire only for chromium + (effective) https + modern ctx + empty Sec-CH-UA.
map "$unmask_ua_chromium:$unmask_forwarded_proto:$unmask_modern_ctx:$http_sec_ch_ua" $unmask_header_mismatch {
    default 0;
    "~^1:https:1:$" 1;   # trailing empty field = no Sec-CH-UA header
}
{{- else }}
# Direct-TLS nginx: $scheme / $server_protocol reflect the visitor.
# Fire only for chromium + https + h2/h3 + empty Sec-CH-UA.
map "$unmask_ua_chromium:$scheme:$unmask_http_modern:$http_sec_ch_ua" $unmask_header_mismatch {
    default 0;
    "~^1:https:1:$" 1;   # trailing empty field = no Sec-CH-UA header
}
{{- end }}
# Escalate a would-pass ({{ if .StaleBrowserEnabled }}post-stale{{ else }}base{{ end }}), not-otherwise-exempt request that mismatches.
# Key: prev : mismatch : search_bot : bypass_ip : bypass_path : bv_valid.
map "{{ if .StaleBrowserEnabled }}$fc_after_stale{{ else }}$final_challenge_base{{ end }}:$unmask_header_mismatch:$is_search_bot:$is_bypass_ip:$is_bypass_path:$bv_any_valid" $final_challenge {
    default          {{ if .StaleBrowserEnabled }}$fc_after_stale{{ else }}$final_challenge_base{{ end }};
    "~^0:1:0:0:0:0$" 1;   # mismatch + no exemption + would-pass -> challenge
}
{{- end }}
{{ if or .WebBotAuthEnabled .PrivacyPassEnabled }}
# -----------------------------------------------------------------------------
# Veto-pass verification plumbing (Web Bot Auth + Privacy Pass)
# -----------------------------------------------------------------------------
# A request carrying a verifiable credential — an RFC 9421 Signature-Input, or
# an RFC 9577 "Authorization: PrivateToken" — detours through server.inc, where
# an auth_request asks the admin daemon to verify it; the daemon's
# X-Unmask-Action rides back and the request re-enters the normal flow.  All
# maps are `volatile`: each is re-evaluated per (sub)request URI / state instead
# of being cached at first touch — the auth_request SUBREQUEST re-runs
# server-scope rewrites with the client's headers, so a cached gate value would
# re-route the verify subrequest away from the daemon (= the pre-v0.1.2 bug
# where the daemon was never reached).

# $unmask_uri_is_unmask: "1" for unmask's own mounts.  Keeps the detour gates
# from firing on (a) a verify subrequest itself (/_unmask/...), and (b)
# challenge-page / admin traffic (/unmask/...).
map $uri $unmask_uri_is_unmask {
    volatile;
    ~^/_unmask/  1;
    ~^/unmask/   1;
    default      0;
}
{{ end }}
{{ if .WebBotAuthEnabled }}
# $unmask_signed_gate: detour ONLY a signed request that is about to be
# challenged.  A signed request that would pass anyway (bypass path / search
# bot / valid _bv / plain content) stays on the fast native path with zero
# subrequest overhead — and keeps working even when the admin daemon is down.
# Ban enforcement stays terminal: the ban if-blocks in server.inc run before
# this gate and short-circuit the rewrite phase.
map "$unmask_has_signed_agent:$unmask_uri_is_unmask:$final_challenge" $unmask_signed_gate {
    volatile;
    "1:0:1"  1;
    default  0;
}

# $unmask_signed_verified: "1" iff the daemon verified the signature AND the
# operator is allowlisted (= X-Unmask-Action: pass).  Any other daemon answer
# (challenge / block / unreachable) leaves it 0.
map $unmask_signed_action $unmask_signed_verified {
    volatile;
    "pass"   1;
    default  0;
}
{{ end }}
{{ if .PrivacyPassEnabled }}
# Privacy Pass / PAT (RFC 9577/9578) — same shape as the signed-agent plumbing.
# $unmask_has_pat detects an "Authorization: PrivateToken" request with a pure
# header match (no plugin var needed): the loop guards are $unmask_uri_is_unmask
# (the verify subrequest lives on /_unmask/) and the server-scope detour rewrite
# that runs once per request.
map $http_authorization $unmask_has_pat {
    volatile;
    ~*^PrivateToken  1;
    default          0;
}

# $unmask_pat_gate: detour ONLY a PrivateToken request about to be challenged.
map "$unmask_has_pat:$unmask_uri_is_unmask:$final_challenge" $unmask_pat_gate {
    volatile;
    "1:0:1"  1;
    default  0;
}

# $unmask_pat_verified: "1" iff the daemon verified the token against a trusted
# issuer (= X-Unmask-Action: pass).  Any other answer leaves it 0.
map $unmask_pat_action $unmask_pat_verified {
    volatile;
    "pass"   1;
    default  0;
}
{{ end }}
{{ if or .WebBotAuthEnabled .PrivacyPassEnabled }}
# $unmask_verified: "1" iff ANY enabled veto-pass feature's daemon verify
# passed.  A disabled feature contributes a literal "0" so the key shape stays
# stable regardless of which features are on.
map "{{ if .WebBotAuthEnabled }}$unmask_signed_verified{{ else }}0{{ end }}:{{ if .PrivacyPassEnabled }}$unmask_pat_verified{{ else }}0{{ end }}" $unmask_verified {
    volatile;
    "0:0"    0;
    default  1;
}

# $final_challenge_eff: the challenge decision protect.inc actually enforces.
# Identical to $final_challenge except a daemon-verified veto-pass is exempt.
# Traffic with no credential never has a verified flag set, so this is a pure
# pass-through for it.
map "$final_challenge:$unmask_verified" $final_challenge_eff {
    volatile;
    "1:0"    1;
    default  0;
}
{{ end }}

# -----------------------------------------------------------------------------
# Rate-limit smart key + zone definitions (provided by unmask / auto-rendered)
# -----------------------------------------------------------------------------
# A naive limit_req_zone keyed on $binary_remote_addr would lump search bots
# and already-CAPTCHA-passed clients into the same counter and reject them
# along with everyone else.  The map below sets the key to "" for "clients we
# want to exclude" so they aren't counted.
#
# Excluded:
#   - bv_any_valid=1   _bv cookie passed (either CAPTCHA or PoW kind)
#   - is_search_bot=1  search bot UA (Googlebot etc.; avoid ranking accidents on large crawls)
#   - is_bypass_ip=1   bypass IP (trusted crawler official IP range / internal LB)
#   - is_bypass_path=1 bypass path (e.g. /static/)
map "$bv_any_valid:$is_search_bot:$is_bypass_ip:$is_bypass_path" $rate_limit_key {
    default       {{ .RateLimitKeyExpr }};
    "~^1:"        "";
    "~^.:1:"      "";
    "~^.:.:1:"    "";
    "~^.:.:.:1$"  "";
}

# $rate_limit_key_deny: identical to $rate_limit_key but WITHOUT the _bv
# exemption.  A "deny" zone is a HARD CAP -- a human who already passed a CAPTCHA
# can still flood -- so _bv holders MUST be counted toward it (issuing CAPTCHAs
# would just sell more requests).  Trusted sources (search bot / bypass IP /
# bypass path) stay exempt in both.  nginx only evaluates this map when a
# deny-mode path zone references it via its conditional key (below).
map "$is_search_bot:$is_bypass_ip:$is_bypass_path" $rate_limit_key_deny {
    default      {{ .RateLimitKeyExpr }};
    "~^1:"       "";
    "~^.:1:"     "";
    "~^.:.:1$"   "";
}

# Path-scoped zone keys: a zone with PathPatterns is applied everywhere
# protect.inc is included, but its key is "" (= nginx skips the limit) unless
# the request URI matches.  This composes the rate-limit with the challenge /
# honeypot / ban / geo protections in the SAME location, instead of a separate
# `location` that would shadow protect.inc and silently disable them.
{{- range .RatePathZones }}
map $request_uri {{ .MatchVar }} {
    default 0;
{{- range .Patterns }}
    "~*^{{ . }}" 1;
{{- end }}
}
map {{ .MatchVar }} {{ .KeyVar }} {
    default "";
    "1" {{ .BaseKey }};
}
{{- end }}

# Zone definitions: auto-rendered from settings.rate_limit.  Users just
# `include /var/lib/unmask/nginx/protect.inc;` and the default zone applies to
# each location.  Path-scoped zones carry a conditional key (above); the rest
# use $rate_limit_key.  Named zones can also be switched per-location by
# manually writing `limit_req zone=...`.
{{- range .RateZones }}
limit_req_zone {{ .KeyVar }} zone={{ .Name }}:10m rate={{ .RequestsPerMin }}r/m;
{{- end }}

# ASN rate zones (auto-rendered from settings.nginx.asn rate rules): throttle a
# datacenter/network to N req/min instead of denying it outright.  Each zone's
# geo maps the rule's CIDRs to the network's own AS number (so the counter is
# per AS number, matching forward-auth), "" elsewhere; the key then drops
# verified crawlers ($is_search_bot) and bypass IPs ($is_bypass_ip) to "" so a
# genuine Googlebot on a throttled ASN is NEVER rate-limited (SEO safety).
{{- range .AsnRateZones }}
geo $remote_addr {{ .RawVar }} {
    default "";
{{ .GeoBody }}}
map "$is_search_bot:$is_bypass_ip:{{ .RawVar }}" {{ .KeyVar }} {
    default    {{ .RawVar }};
    "~^1:"     "";
    "~^.:1:"   "";
}
limit_req_zone {{ .KeyVar }} zone={{ .ZoneName }}:10m rate={{ .RequestsPerMin }}r/m;
{{- end }}

# Country rate zones (auto-rendered from settings.nginx.geo rate rules): the
# by-country twin of the ASN zones above.  Each keys on the already-resolved
# $unmask_country -- exact-match on the zone's country, "" otherwise, with
# verified crawlers ($is_search_bot) and bypass IPs ($is_bypass_ip) dropped to
# "" so a genuine crawler from a throttled country is NEVER rate-limited.
{{- range .GeoRateZones }}
map "$is_search_bot:$is_bypass_ip:$unmask_country" {{ .KeyVar }} {
    default    "";
    "0:0:{{ .Country }}" "{{ .Country }}";
}
limit_req_zone {{ .KeyVar }} zone={{ .ZoneName }}:10m rate={{ .RequestsPerMin }}r/m;
{{- end }}

# Distinguish whether the request went through rate-limit (i.e. carries ?_rl=1).
map $args $rl_hit {
    default "0";
    "~_rl=1" "1";
}
{{ if .ComposeMode }}
# Compose-mode fail-open recovery maps (host nginx >= 1.17.6).  In compose mode the
# plugin's ACCESS-phase handler does the challenge / rate redirect via
# ngx_http_internal_redirect, which restarts the phase engine from POST_READ --
# re-running server.inc's SERVER_REWRITE `set $unmask_orig_path ""`, clearing the
# saved original before @unmask_daemon_down's fail-open replay can read it.  (The
# classic `rewrite ... last` jumps to FIND_CONFIG, skipping SERVER_REWRITE, so it
# survives there.)  So @unmask_daemon_down instead recovers the original from what
# the handler carried in the redirect; these maps split it back into a clean path
# + args.
#   - challenge route: the _orig query arg holds the original request URI
#     ($arg__orig = "<path>" or "<path>?<query>").
#   - rate route: the original is the /unmask/_rl URI suffix ($uri minus the
#     prefix); its args ride along in $args.
#
# SECURITY: gated on $unmask_compose=1, which only protect.inc's compose branch
# sets (and which survives to @unmask_daemon_down -- nothing resets it at server
# scope).  A server-scope BAN rewrite (-> /unmask/challenge/, preserving the
# client's raw args) and a direct /unmask/_rl hit both leave $unmask_compose
# UNSET, so a client-supplied `?_orig=` or a crafted /unmask/_rl/<path> is NOT
# honored -- those keep landing in the 503 branch, preserving the "bans hold
# during a daemon outage" contract.  Without the gate a banned client could
# craft `?_orig=/wherever` and have the outage replay smuggle them past the ban.
map $unmask_compose $unmask_co_orig {
    default "";
    "1" $arg__orig;                 # expose the carried _orig only for compose
}
map $unmask_co_orig $unmask_orig_arg_path {
    default $unmask_co_orig;        # no query -> the whole arg is the path
    "~^(?<__op>[^?]*)\?" $__op;     # has query -> everything before the ?
}
map $unmask_co_orig $unmask_orig_arg_args {
    default "";
    "~^[^?]*\?(?<__oa>.*)$" $__oa;  # everything after the first ?
}
map $unmask_compose $unmask_co_uri {
    default "";
    "1" $uri;                       # expose $uri to the rate-route strip only for compose
}
map $unmask_co_uri $unmask_rl_orig {
    default "";
    "~^/unmask/_rl(?<__rp>/.*)$" $__rp;
}
{{ end }}

# -----------------------------------------------------------------------------
# $unmask_site: the site key the native module binds the _bv cookie to.  Kept
# at "default" so _bv stays site-agnostic (kind "captcha"), matching the admin
# (VerifyJSON issues a site-agnostic kind).  Per-vhost stats use $host directly
# instead (see log_format unmask_minimal + the bypass-path map); making _bv
# itself site-bound is a separate step (multi-site-handoff.md phase 6).
# -----------------------------------------------------------------------------
map "" $unmask_site {
    default "default";
}

# -----------------------------------------------------------------------------
# The upstream is defined by the unmask-web-nginx package in
# /etc/nginx/conf.d/unmask-web.conf (shared by both modes).  Duplicating it
# here would prevent nginx from starting.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# log format (for ops investigation; reference from any access_log)
# -----------------------------------------------------------------------------
log_format unmask '$remote_addr [$time_local] "$request" $status '
                  '"$http_user_agent" '
                  'ja4=$effective_ja4 v=$ja4_verdict a=$ja4_action '
                  'diag=$ja4_diag '
                  'bv_kind=$bv_kind hp=$serve_bot_challenge rl=$rl_hit';

# -----------------------------------------------------------------------------
# access_log for the cookie-traversal dashboard (unix datagram socket)
# -----------------------------------------------------------------------------
# admin binds `{{ .NginxLogSocket }}` and the nginx worker sends datagrams.
# If admin is not running, nginx only emits a warning — no behavior impact.
#
# kind=$bv_kind is the cookie validation result string ("captcha" / "pow" /
# empty).  admin aggregates per kind (the kind column of unmask_cookie_minute),
# so when the plugin adds new kinds (e.g. "signature") they're auto-ingested
# without schema changes.
#
# ua=$http_user_agent MUST stay last (it contains spaces).  admin classifies it
# into crawler categories for the overview "crawler traffic" funnel — this is
# the only way a rescued crawler (passed straight through, never in
# unmask_event) is counted.  nginx default-escapes the value, so no log
# injection via a crafted UA.
log_format unmask_minimal '$msec site=$host kind=$bv_kind fc=$final_challenge hp=$serve_bot_challenge ip=$remote_addr ja4=$effective_ja4 hpuri=$unmask_hp_uri ua=$http_user_agent';
{{- if .NginxLogEnabled }}
# if=$unmask_log_keep drops nginx.stats_exclude_ips from the dashboard feed.
access_log syslog:server=unix:{{ .NginxLogSocket }} unmask_minimal if=$unmask_log_keep;
{{- else }}
# nginx_log.socket_path is empty in config.yml, so access_log is not emitted.
{{- end }}

# -----------------------------------------------------------------------------
# The daemon upstream (`upstream unmask_daemon`) is NOT defined here: both
# deploy modes share the single definition in upstream.conf (rendered next to
# this file; the unmask-web-nginx package symlinks it into conf.d/).  Native
# setups that include the rendered files by hand need
# `include <output-dir>/upstream.conf;` alongside http.inc.
# -----------------------------------------------------------------------------
