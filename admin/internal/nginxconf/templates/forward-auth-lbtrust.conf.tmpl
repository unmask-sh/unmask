# =============================================================================
# unmask: forward-auth LB-trust gate (= auto-generated by `unmask render-nginx`)
# =============================================================================
#
#  DO NOT EDIT THIS FILE.  Regenerated from /etc/unmask/config.yml on every
#  `unmask render-nginx` (= every settings save).  Edit config.yml instead.
#
#  generated_at: {{ .GeneratedAt }}
#  unmask_version: {{ .Version }}
#
#  Purpose (forward-auth mode): expose $unmask_fa_ja4 = the real client JA4 a
#  front LB / CDN forwarded, but ONLY when the request's original peer
#  ($realip_remote_addr) is inside a trusted LB range below; "" for any other
#  source.  forward-auth/server.inc forwards $unmask_fa_ja4 as X-Client-JA4 to
#  the daemon, so a direct visitor can never spoof a JA4 -- the value is dropped
#  at the edge before the verify subrequest is made.  Trusted ranges come from
#  nginx.trusted_lb_presets / trusted_lb_extra (the same list native mode's
#  http.inc uses), so one setting drives both modes.
#
#  Place this in your nginx http {} block (the unmask-web-nginx package wires a
#  symlink in conf.d/ automatically):
#
#      http {
#          include {{ .OutputDir }}/forward-auth-lbtrust.conf;
#          ...
#      }
#
#  Always emitted (a no-op `default ""` when no LB is configured) so server.inc's
#  reference to $unmask_fa_ja4 always resolves and `nginx -t` passes.  It carries
#  no plugin variables, so it loads fine with or without the native module.

# 1) original source IP -> vendor name.  Non-LB IPs get "" (their JA4 header is
#    ignored).  Evaluated on $realip_remote_addr (= the peer before the realip
#    module rewrites $remote_addr to the visitor IP from X-Forwarded-For), so a
#    request relayed by a trusted LB matches its range and a direct visitor does
#    not.  Environments without the realip module get "" -> safe (JA4 silent).
geo $realip_remote_addr $unmask_fa_lb_vendor {
    default "";
{{- range $g := .LBIPRanges }}
{{- if $g.CIDRs }}

    # {{ $g.Label }} ({{ $g.Source }})
{{- range $g.CIDRs }}
    {{ . }} "{{ $g.ID }}";
{{- end }}
{{- end }}
{{- end }}
}

# 2) vendor name -> the JA4 header that vendor forwards (= $http_x_client_ja4 for
#    most, $http_cf_ja4 for Cloudflare, etc.).  default "" = outside every
#    trusted LB, so any forwarded JA4 is discarded.
map $unmask_fa_lb_vendor $unmask_fa_ja4 {
    default "";
{{- range .LBIPRanges }}
{{- if .CIDRs }}
    "{{ .ID }}" {{ .Header }};
{{- end }}
{{- end }}
}
