# =============================================================================
# unmask: forward-auth admin upstream (= auto-generated by `unmask render-nginx`)
# =============================================================================
#
#  DO NOT EDIT THIS FILE.  Regenerated from /etc/unmask/config.yml on every
#  `unmask render-nginx` (= every settings save), so it tracks server.bind /
#  server.port automatically.  Edit config.yml instead.
#
#  generated_at: {{ .GeneratedAt }}
#  unmask_version: {{ .Version }}
#
#  forward-auth mode has no http.inc (that is native-only, and it carries its own
#  `upstream unmask` at its tail), so the admin upstream that
#  forward-auth/server.inc proxies to (`http://unmask_daemon`) is defined here
#  instead.  The unmask-web-nginx package symlinks it into conf.d/ so it loads in
#  http {}.
upstream unmask_daemon {
    server {{ .UpstreamServer }};
    keepalive 16;
}
