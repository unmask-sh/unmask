# =============================================================================
# unmask: forward-auth admin upstream (= auto-generated by `unmask render-nginx`)
# =============================================================================
#
#  DO NOT EDIT THIS FILE.  Regenerated from /etc/unmask/config.yml on every
#  `unmask render-nginx` (= every settings save), so it tracks server.bind /
#  server.port automatically.  Edit config.yml instead.
#
#  generated_at: {{ .GeneratedAt }}
#  unmask_version: {{ .Version }}
#
#  The ONE definition of the daemon upstream, shared by both deploy modes:
#  native's server.inc and forward-auth/server.inc both proxy to
#  `http://unmask_daemon`, and this file is the only place the upstream is
#  defined (http.inc deliberately carries none, so loading both never
#  duplicates it).  The unmask-web-nginx package symlinks it into conf.d/ so
#  it loads in http {}.
#
#  bind forms (= server.bind in config.yml):
#    - TCP    : "127.0.0.1:9477"        -> `server 127.0.0.1:9477;`
#    - socket : "unix:/path/to.sock"    -> `server unix:/path/to.sock;`
#  Socket eliminates port collisions + slightly faster than TCP loopback.
#  server.socket_mode / .socket_group in config.yml control its permissions.
upstream unmask_daemon {
    server {{ .UpstreamServer }};
    keepalive 16;
}
