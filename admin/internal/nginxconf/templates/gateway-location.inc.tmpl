# {{ .OutputDir }}/gateway-location.inc — auto-rendered by unmask / DO NOT EDIT
#
# generated_at: {{ .GeneratedAt }} / version: {{ .Version }}
#
# The gateway's proxy location (settings > Gateway > upstream).  The nginx
# image includes it, through /etc/nginx/unmask-gateway-location.inc, in the
# :80 server and in every :443 block of gateway-vhosts.inc.  server scope.
{{- if .Gateway.Upstream }}
location / {
    include /etc/unmask/protect.inc;
    proxy_pass {{ .Gateway.Upstream }};
    proxy_http_version 1.1;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_ssl_server_name on;
    proxy_ssl_name $host;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    # https on :443; on :80 as received -- a health check carries none, a
    # balancer that terminated TLS says https.  The map is the image's.
    proxy_set_header X-Forwarded-Proto $unmask_gw_xfp;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
}
{{- else }}
# unmask-gateway-upstream: none
# No upstream configured yet.  The nginx image falls back to its own
# UNMASK_UPSTREAM if it has one, and otherwise answers every request with a
# notice pointing at settings > Gateway.
{{- end }}
