#!/bin/sh
# Gateway mode switch for the unmask nginx image.
#
# Sourced (not executed) by the stock /docker-entrypoint.sh -- that is what
# the .envsh suffix means there -- so the defaults exported here are visible
# to 20-envsubst-on-templates.sh, which renders ${UNMASK_*} in the gateway
# template.  A plain .sh runs in its own process and its exports would be
# lost; that is exactly how the first cut failed ("unknown unmask_tls_cert
# variable").
#
# Off unless UNMASK_GATEWAY=1 (or, the 0.1.37 way, UNMASK_UPSTREAM is set):
# without either the image is a plain nginx with the module loaded, and your
# own conf.d applies (module-only use).
#
# Everything about the gateway -- the upstream, the hostnames, where the
# certificates come from (Let's Encrypt via nginx's ACME module, a pasted
# certificate, mounted files, or the self-signed pair of the first start) --
# is settings > Gateway in the admin, rendered into the shared volume as
# gateway-*.inc.  The admin container seeds those settings from its
# environment on first boot; this side waits for the files and falls back
# to its own UNMASK_UPSTREAM / UNMASK_TRUSTED_PROXIES while the tab leaves
# them empty (gateway-includes.sh).
case "${UNMASK_GATEWAY:-}" in 1|true|yes|on) UNMASK_GATEWAY=1 ;; *) UNMASK_GATEWAY="" ;; esac
if [ -n "${UNMASK_UPSTREAM:-}${UNMASK_GATEWAY}" ]; then
    export UNMASK_UPSTREAM

    # The stock default vhost owns :80; the gateway replaces it.
    rm -f /etc/nginx/conf.d/default.conf

    # The ACME module resolves the ACME server itself and needs a resolver;
    # this container knows its own nameservers, the admin does not, so the
    # line is written here (harmless when ACME is not in use).
    resolvers=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf)
    resolvers="${resolvers% }"
    [ -n "$resolvers" ] || resolvers="127.0.0.11"
    printf '# written by 10-unmask-gateway.envsh from /etc/resolv.conf\nresolver %s;\n' "$resolvers" > /etc/nginx/unmask-resolver.inc

    # The includes are rendered by the admin container into the shared volume.
    # Under compose the admin healthcheck orders the two, but give a plain
    # `docker run` a moment before nginx -t fails on a missing include.
    for f in http.inc upstream.conf server.inc protect.inc forward-auth-lbtrust.conf gateway-server.inc gateway-tls.inc gateway-acme.inc gateway-vhosts.inc; do
        i=0
        while [ ! -f "/etc/unmask/$f" ]; do
            i=$((i+1))
            if [ "$i" -gt 30 ]; then
                case "$f" in
                    gateway-*) echo "unmask-gateway: /etc/unmask/$f is missing after 60s -- the admin container renders it from settings > Gateway; under compose, set UNMASK_GATEWAY=1 on the admin service so its first boot seeds them" >&2 ;;
                    *)         echo "unmask-gateway: /etc/unmask/$f is missing after 60s -- is the admin container up, and is /etc/unmask shared with it?" >&2 ;;
                esac
                exit 1
            fi
            [ "$i" -eq 1 ] && echo "unmask-gateway: waiting for the admin container to render /etc/unmask/$f ..." >&2
            sleep 2
        done
    done
    # The template for what the gateway listens on (settings > Gateway >
    # listen: both, :80 only, :443 only), the proxy location and the trusted
    # proxies: the admin's when set there, this container's environment
    # otherwise.  The watcher re-evaluates all of it on every change.
    . /usr/share/unmask/gateway-includes.sh
    unmask_gateway_template || true
    unmask_gateway_includes
    tls=$UNMASK_GATEWAY_TLS
    # A certificate from files must exist before nginx starts, or -t fails
    # with a less helpful message.  ACME needs nothing on disk.
    if [ "$tls" = files ]; then
        for f in $(sed -n 's/^[[:space:]]*ssl_certificate\(_key\)\?[[:space:]]\+\([^;$]*\);.*/\2/p' /etc/unmask/gateway-vhosts.inc); do
            [ -f "$f" ] || { echo "unmask-gateway: TLS file $f not found -- mount your certificate at /etc/unmask/tls, paste one in settings > Gateway, or switch that tab to Let's Encrypt" >&2; exit 1; }
        done
    fi
    [ -n "$UNMASK_GATEWAY_TRUSTED" ] && echo "unmask-gateway: trusted proxies:$UNMASK_GATEWAY_TRUSTED (visitor address from X-Forwarded-For)"
    case "$UNMASK_GATEWAY_LOCATION_SOURCE" in
        admin) target="$(sed -n 's/^[[:space:]]*proxy_pass[[:space:]]\+\([^;]*\);.*/\1/p' /etc/unmask/gateway-location.inc | head -1) (settings > Gateway)" ;;
        env)   target="${UNMASK_UPSTREAM} (UNMASK_UPSTREAM)" ;;
        *)     target="no upstream yet -- set it under settings > Gateway" ;;
    esac
    echo "unmask-gateway: $UNMASK_GATEWAY_LISTEN -> $target ($(grep -c '^server {' /etc/unmask/gateway-vhosts.inc) server(s): $(sed -n 's/^[[:space:]]*server_name[[:space:]]\+\([^;]*\);.*/\1/p' /etc/unmask/gateway-vhosts.inc | tr '\n' ',' | sed 's/,$//'); tls: $tls)"
fi
