#!/bin/sh
# Gateway mode switch for the unmask nginx image.
#
# Sourced (not executed) by the stock /docker-entrypoint.sh -- that is what
# the .envsh suffix means there -- so the defaults exported here are visible
# to 20-envsubst-on-templates.sh, which renders ${UNMASK_*} in the gateway
# template.  A plain .sh runs in its own process and its exports would be
# lost; that is exactly how the first cut failed ("unknown unmask_tls_cert
# variable").
#
# Off unless UNMASK_UPSTREAM is set: without it the image is a plain nginx
# with the module loaded, and your own conf.d applies (module-only use).
#
# Everything else about the vhost -- its name, where the certificate comes
# from (Let's Encrypt via nginx's ACME module, a pasted certificate, or
# mounted files) -- is settings > Gateway in the admin, rendered into the
# shared volume as gateway-*.inc.  The admin container seeds those settings
# from its environment on first boot; this side only waits for the files.
if [ -n "${UNMASK_UPSTREAM:-}" ]; then
    export UNMASK_UPSTREAM

    # The stock default vhost owns :80; the gateway replaces it with a redirect.
    rm -f /etc/nginx/conf.d/default.conf
    mkdir -p /etc/nginx/templates
    cp /usr/share/unmask/gateway.conf.template /etc/nginx/templates/unmask-gateway.conf.template

    # The ACME module resolves the ACME server itself and needs a resolver;
    # this container knows its own nameservers, the admin does not, so the
    # line is written here (harmless when ACME is not in use).
    resolvers=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf)
    resolvers="${resolvers% }"
    [ -n "$resolvers" ] || resolvers="127.0.0.11"
    printf '# written by 10-unmask-gateway.envsh from /etc/resolv.conf\nresolver %s;\n' "$resolvers" > /etc/nginx/unmask-resolver.inc

    # The includes are rendered by the admin container into the shared volume.
    # Under compose the admin healthcheck orders the two, but give a plain
    # `docker run` a moment before nginx -t fails on a missing include.
    # Behind a load balancer: UNMASK_TRUSTED_PROXIES lists its address ranges
    # (space separated).  The visitor's address is then taken from the
    # X-Forwarded-For those proxies send, so bans, rate limits and geo rules
    # see the visitor rather than the balancer.  (X-Forwarded-Proto is read
    # by the rendered config itself; a balancer that terminates TLS and
    # forwards on :80 is served on :80 like :443.)
    {
        printf '# written by 10-unmask-gateway.envsh from UNMASK_TRUSTED_PROXIES\n'
        trusted=""
        for cidr in ${UNMASK_TRUSTED_PROXIES:-}; do
            case "$cidr" in
                *[!0-9a-fA-F:./]*) echo "unmask-gateway: ignoring UNMASK_TRUSTED_PROXIES entry '$cidr' (not an address or CIDR)" >&2; continue ;;
            esac
            trusted="$trusted $cidr"
            printf 'set_real_ip_from %s;\n' "$cidr"
        done
        if [ -n "$trusted" ]; then
            printf 'real_ip_header X-Forwarded-For;\nreal_ip_recursive on;\n'
        fi
    } > /etc/nginx/unmask-gateway-proxies.inc
    for f in http.inc upstream.conf server.inc protect.inc forward-auth-lbtrust.conf gateway-server.inc gateway-tls.inc gateway-acme.inc; do
        i=0
        while [ ! -f "/etc/unmask/$f" ]; do
            i=$((i+1))
            if [ "$i" -gt 30 ]; then
                case "$f" in
                    gateway-*) echo "unmask-gateway: /etc/unmask/$f is missing after 60s -- the admin container renders it from settings > Gateway; under compose, pass UNMASK_SERVER_NAME (and UNMASK_ACME_EMAIL or a certificate) to the admin service so its first boot seeds them" >&2 ;;
                    *)         echo "unmask-gateway: /etc/unmask/$f is missing after 60s -- is the admin container up, and is /etc/unmask shared with it?" >&2 ;;
                esac
                exit 1
            fi
            [ "$i" -eq 1 ] && echo "unmask-gateway: waiting for the admin container to render /etc/unmask/$f ..." >&2
            sleep 2
        done
    done
    # A certificate from files must exist before nginx starts, or -t fails
    # with a less helpful message.  ACME needs nothing on disk.
    if ! grep -q '^acme_certificate' /etc/unmask/gateway-tls.inc; then
        for f in $(sed -n 's/^ssl_certificate\(_key\)\?[[:space:]]\+\([^;]*\);.*/\2/p' /etc/unmask/gateway-tls.inc); do
            [ -f "$f" ] || { echo "unmask-gateway: TLS file $f not found -- mount your certificate at /etc/unmask/tls, paste one in settings > Gateway, or switch that tab to Let's Encrypt" >&2; exit 1; }
        done
    fi
    [ -n "$trusted" ] && echo "unmask-gateway: trusted proxies:$trusted (visitor address from X-Forwarded-For)"
    echo "unmask-gateway: :443 -> ${UNMASK_UPSTREAM} ($(sed -n 's/^server_name[[:space:]]\+\([^;]*\);.*/server_name \1/p' /etc/unmask/gateway-server.inc); tls: $(grep -q '^acme_certificate' /etc/unmask/gateway-tls.inc && echo ACME || echo files))"
fi
