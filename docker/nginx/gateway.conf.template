# unmask gateway vhost -- rendered into conf.d by the stock nginx entrypoint
# (envsubst) when UNMASK_UPSTREAM is set.  http scope, like every conf.d file.
#
# Only ${UNMASK_*} placeholders are substituted; nginx's own $variables are
# left alone because the entrypoint substitutes defined environment names
# only.

include /etc/unmask/http.inc;
include /etc/unmask/upstream.conf;
include /etc/unmask/forward-auth-lbtrust.conf;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${UNMASK_SERVER_NAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${UNMASK_SERVER_NAME};

    ssl_certificate     ${UNMASK_TLS_CERT};
    ssl_certificate_key ${UNMASK_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    # unmask: ban enforcement, the /unmask/ admin + challenge routes, and the
    # daemon-down fail-open live here (rendered by the admin container).
    include /etc/unmask/server.inc;

    location / {
        # The challenge decision for everything proxied.
        include /etc/unmask/protect.inc;

        proxy_pass ${UNMASK_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}
