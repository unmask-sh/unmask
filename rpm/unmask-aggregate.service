[Unit]
Description=unmask aggregate (incremental rollup of unmask_event)
After=unmask-admin.service

[Service]
Type=oneshot
User=unmask
Group=unmask
Environment=UNMASK_CONFIG=/etc/unmask/config.yml
ExecStart=/usr/sbin/unmask-admin aggregate -days 7

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/unmask /var/log/unmask
