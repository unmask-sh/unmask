# Shipped by unmask-plugin-nginx; started by unmask-nginx-binary.path, which
# place-module.sh writes for an nginx built from source (a distribution's
# nginx has no such unit and never starts this).
#
# The binary of that nginx changed or went: a rebuild, a hosting panel
# installing another version.  The module on disk was built for the old one,
# and whoever installs the new one may test its configuration before any
# service starts it -- so unmask takes its module out and renders its include
# files with nothing in them, and the new build loads whatever nginx.conf it
# is given.  nginx itself is not touched.  The module for the new build is
# placed by the ordinary run of the same script, before nginx's service
# starts (nginx.service.d/10-unmask-repick.conf).
[Unit]
Description=unmask: an nginx built from source changed -- take the module out until it is placed for the new build

[Service]
Type=oneshot
ExecStart=/bin/sh /usr/share/unmask/plugin/place-module.sh --nginx-changed
