#!/bin/sh
#
# unmask-admin — JA4 bot challenge admin server (SysVinit)
#
# Use: CentOS 6 / RHEL 6 / legacy SysVinit hosts.
# On systemd hosts, rpm/unmask-admin.service is enabled instead.
#
# chkconfig: 2345 86 14
# description: unmask admin server (JA4 bot challenge backend)
# processname: unmask-admin
# pidfile: /var/run/unmask/unmask-admin.pid

### BEGIN INIT INFO
# Provides:          unmask-admin
# Required-Start:    $local_fs $network $remote_fs
# Required-Stop:     $local_fs $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: unmask admin server
# Description:       JA4 bot challenge admin / config UI / event collector.
### END INIT INFO

# CentOS 6-family function lib (= daemon, killproc, status, success, failure, etc.).
. /etc/rc.d/init.d/functions

NAME=unmask-admin
EXEC=/usr/sbin/${NAME}
CONFIG=/etc/unmask/config.yml
USER=unmask
GROUP=unmask
LOGFILE=/var/log/unmask/admin.log
PIDFILE=/var/run/unmask/${NAME}.pid
LOCKFILE=/var/lock/subsys/${NAME}
RUNTIME_DIR=/var/run/unmask

[ -x "$EXEC" ] || { echo "$EXEC not installed"; exit 5; }
[ -f "$CONFIG" ] || { echo "$CONFIG not found"; exit 6; }

# /var/run/unmask/ is tmpfs (= cleared on reboot), so ensure it each time.
prepare_runtime() {
    [ -d "$RUNTIME_DIR" ] || install -d -m 0750 -o "$USER" -g "$GROUP" "$RUNTIME_DIR"
    [ -d /var/log/unmask ] || install -d -m 0750 -o "$USER" -g "$GROUP" /var/log/unmask
}

start() {
    echo -n "Starting $NAME: "
    prepare_runtime
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo -n "(already running) "
        success; echo
        return 0
    fi
    # daemon is provided by CentOS 6's rc.d/init.d/functions.
    # pid handling: nohup + & for background start, save pid to file.
    daemon --user "$USER" --pidfile "$PIDFILE" \
        "nohup $EXEC serve -config $CONFIG >> $LOGFILE 2>&1 & echo \$! > $PIDFILE"
    RETVAL=$?
    [ $RETVAL -eq 0 ] && touch "$LOCKFILE"
    echo
    return $RETVAL
}

stop() {
    echo -n "Stopping $NAME: "
    if [ -f "$PIDFILE" ]; then
        killproc -p "$PIDFILE" "$NAME"
        RETVAL=$?
    else
        # Fallback: kill by process name.
        killproc "$NAME"
        RETVAL=$?
    fi
    [ $RETVAL -eq 0 ] && rm -f "$LOCKFILE" "$PIDFILE"
    echo
    return $RETVAL
}

restart() {
    stop
    sleep 1
    start
}

reload() {
    # We want unmask-admin to hot-reload settings on SIGHUP, but currently
    # this is equivalent to restart.  Once SIGHUP is supported, send kill -HUP here.
    restart
}

status_check() {
    status -p "$PIDFILE" "$NAME"
    return $?
}

case "$1" in
    start)        start ;;
    stop)         stop ;;
    restart)      restart ;;
    reload)       reload ;;
    status)       status_check ;;
    condrestart|try-restart)
        status_check >/dev/null 2>&1 && restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload|status|condrestart}"
        exit 2
        ;;
esac
exit $?
