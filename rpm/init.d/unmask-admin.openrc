#!/sbin/openrc-run
# unmask-admin OpenRC init script (= for Alpine 3.21+ / Gentoo / other OpenRC hosts).
#
# SysVinit hosts like RHEL 6 / CentOS 6 use init.d/unmask-admin (= depends on the
# functions library).  systemd hosts use rpm/unmask-admin.service.
#
# OpenRC controls daemons via openrc-run scripts.  command_background=true makes
# nfpm fork the non-forking daemon and manage its pid file.

name="unmask-admin"
description="unmask admin server (JA4 bot challenge backend)"

command="/usr/sbin/unmask-admin"
command_args="serve -config /etc/unmask/config.yml"
command_user="unmask:unmask"
command_background=true

pidfile="/var/run/unmask/unmask-admin.pid"
output_log="/var/log/unmask/admin.log"
error_log="/var/log/unmask/admin.log"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath -d -m 0750 -o unmask:unmask /var/run/unmask
    checkpath -d -m 0750 -o unmask:unmask /var/log/unmask
}
