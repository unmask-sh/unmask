[Unit]
Description=unmask admin (JA4 bot challenge backend)
Documentation=https://github.com/unmask-sh/unmask
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unmask
Group=unmask
# Add admin to the nginx group so nginx workers can write to /run/unmask/log.sock.
# (= the shipped preinstall script runs `usermod -aG nginx unmask`.)
SupplementaryGroups=nginx

# Config: /etc/unmask/config.yml.  Overridable via -config.
Environment=UNMASK_CONFIG=/etc/unmask/config.yml
ExecStart=/usr/sbin/unmask serve

# Auto-create /run/unmask/ on startup (= unmask:unmask, on tmpfs).  admin
# binds log.sock and the optional unix:/run/unmask/http.sock here, and nginx
# workers must TRAVERSE the directory to reach either.  0755 grants traverse
# only — access control stays on each socket's own mode (the daemon chmods
# them at bind).  0750 left the unix-socket admin bind 502ing whenever
# nginx_log was off, because nginxlog.Start was the only code path that
# widened the directory.
RuntimeDirectory=unmask
RuntimeDirectoryMode=0755

# Hardening (= systemd hardening)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
# Drop every capability: admin binds an unprivileged port (= 9477) and writes
# only to its own data dirs.  No CAP_NET_BIND_SERVICE / CAP_DAC_* / etc. needed.
CapabilityBoundingSet=
AmbientCapabilities=
# Refuse setuid / setgid binaries inside the unit (matches NoNewPrivileges).
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# Don't share the kernel keyring with other services.
KeyringMode=private
# 0027 = world has no access to anything admin creates (e.g. dropped event
# logs); the unmask group still gets read.
UMask=0027
# /etc/unmask needs write access so the web settings UI can update config.yml + nginx-rendered*.conf.
ReadWritePaths=/var/lib/unmask /run/unmask /etc/unmask
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# resource
LimitNOFILE=65536
Restart=on-failure
RestartSec=5s

# 12-factor logging: admin writes to stderr; journald captures.
# `journalctl -u unmask` shows all admin output; retention is managed by
# /etc/systemd/journald.conf (= no app-side rotation).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
