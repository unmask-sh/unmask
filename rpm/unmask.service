[Unit]
Description=unmask admin (JA4 bot challenge backend)
Documentation=https://github.com/unmask-sh/unmask
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unmask
Group=unmask
# Add admin to the nginx group so nginx workers can write to /run/unmask/log.sock.
# (= the shipped preinstall script runs `usermod -aG nginx unmask`.)
SupplementaryGroups=nginx

# Config: /etc/unmask/config.yml.  Overridable via -config.
Environment=UNMASK_CONFIG=/etc/unmask/config.yml
ExecStart=/usr/sbin/unmask serve

# Auto-create /run/unmask/ on startup (= 0750 unmask:unmask, on tmpfs).
# admin binds log.sock here; group access is needed for sharing.
RuntimeDirectory=unmask
RuntimeDirectoryMode=0750

# Hardening (= systemd hardening)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
# /etc/unmask needs write access so the web settings UI can update config.yml + nginx-rendered*.conf.
ReadWritePaths=/var/lib/unmask /run/unmask /etc/unmask
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# resource
LimitNOFILE=65536
Restart=on-failure
RestartSec=5s

# 12-factor logging: admin writes to stderr; journald captures.
# `journalctl -u unmask` shows all admin output; retention is managed by
# /etc/systemd/journald.conf (= no app-side rotation).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
