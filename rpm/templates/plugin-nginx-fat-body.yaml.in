# plugin-nginx-fat-body.yaml.in — body for the fat variant of
# unmask-plugin-nginx (= bundles .so files for multiple nginx versions in one
# package).
#
# postinstall picks and cp's the .so built for exactly the host's nginx version
# out of the bundle (nginx loads no other, a neighbouring patch release
# included); with none for that version it says so and exits 1, and the
# fail-safe leaves nginx running without the module.
#
# Bundled versions are everything sitting under build/multi-modules/.  Run
# `make build-module-multi` to build them all first, then package.

description: |
  unmask nginx dynamic module (ngx_http_unmask_module.so).
  Computes the JA4 TLS fingerprint and verifies the pass cookie inside
  nginx; the recommended native setup runs on it.
  Bundles modules for multiple nginx versions; postinstall picks the one
  matching the host nginx automatically.
  Requires the unmask package of the same version and a host nginx built
  with --with-compat.

depends:
  - unmask

# nginx is named, not required (rpm and deb; apk is below).  The module goes
# into the nginx the host runs -- a distribution's, nginx.org's, one built
# from source -- and only a package can meet a dependency: where no package
# installed nginx, requiring it made dnf and apt install the distribution's
# beside the one in use, a second nginx that takes the name on PATH.  So
# these packages never install an nginx.  With none on the host the
# postinstall says so and places nothing; the nginx.service drop-in places
# the module when an nginx installed later starts.
#
# Suggests, because neither resolver installs one.  A Recommends is installed
# by default, and dnf 4.7 (RHEL 8) installs it again on each upgrade of the
# package that names it.  A suggestion still does two things: apt keeps a
# suggested package off its autoremove list, and the rpm of RHEL 8 and later
# installs it first when it is in the same transaction (RHEL 7's and 6's
# ignore the tag).  dnf's autoremove does not count a suggestion: it keeps
# the nginx the operator installed by name.
suggests:
  - nginx

overrides:
  # Pin unmask to the EXACT build version per packager (rpm `=`, deb `(= )`,
  # apk `=`): the .so and the daemon share the _bv / JA4 contract, so a mixed
  # upgrade must be impossible.  nfpm overrides REPLACE the top-level depends.
  #
  # deb and apk need the RELEASE as well, rpm does not.  rpm's `=` with no
  # release given matches any release; dpkg and apk compare the whole version
  # string, so `(= 0.1.21)` against an installed 0.1.21-1 is simply unsatisfied
  # -- apt reports "held broken packages" and apk "breaks: ...[unmask=0.1.21]".
  # Measured on all three after the release became settable.
  rpm:
    depends:
      - "unmask = ${UNMASK_VERSION}"
  deb:
    depends:
      - "unmask (= ${UNMASK_VERSION}-${UNMASK_RELEASE})"
  # apk requires nginx.  It has nothing weaker than a dependency, no hook
  # that places the module when an nginx arrives later (no systemd), and it
  # removes a package nothing depends on unless /etc/apk/world names it.
  #
  # On Alpine, gcompat lets nginx (musl-linked) dlopen our glibc-built
  # plugin .so.  Without it the module fails to load and the challenge
  # never fires.  Pin as a hard apk dependency so `apk add unmask-plugin-nginx`
  # pulls it in by default.
  apk:
    # apk runs no maintainer script on `apk upgrade` without an
    # apk-specific post-upgrade hook; re-run the idempotent postinstall.
    apk:
      scripts:
        postupgrade: ./scripts/postinstall-plugin-nginx-fat.sh
    depends:
      - "unmask=${UNMASK_APK_PKGVER}"
      - nginx
      - gcompat

scripts:
  postinstall: ./scripts/postinstall-plugin-nginx-fat.sh
  preremove: ./scripts/preremove-plugin-nginx.sh

# The Makefile's package-plugin-nginx-fat target walks the build-module-multi
# output (= dist/multi-modules/<X.Y.Z>/ngx_http_unmask_module.so), appends the
# .so entries after these, then invokes nfpm pkg.
contents:
  # On-disk module placer, shared by the postinstall scriptlet and the
  # nginx.service ExecStartPre drop-in (= the host-nginx-upgrade re-pick).
  - src: ./scripts/place-module.sh
    dst: /usr/share/unmask/plugin/place-module.sh
    file_info:
      mode: 0755
  # nginx.service drop-in: re-pick the module for the running nginx version
  # before nginx starts, so a host nginx upgrade can't orphan the .so and kill
  # nginx.  Non-fatal ExecStartPre; degrades to module-off if no .so matches.
  - src: ./nginx-unmask-repick.conf
    dst: /usr/lib/systemd/system/nginx.service.d/10-unmask-repick.conf
    file_info:
      mode: 0644
  # What the watch on a self-built nginx's binary starts (the watch itself,
  # unmask-nginx-binary.path, names that host's file and is written by the
  # placer): the module is taken out when the binary changes, so the next
  # build loads its configuration.  Never started on a distribution's nginx.
  - src: ./unmask-nginx-binary.service
    dst: /usr/lib/systemd/system/unmask-nginx-binary.service
    file_info:
      mode: 0644
  # The license and the notices, as in the main package (the module is built
  # from this project's C source; THIRD-PARTY-NOTICES.md has its section).
  - src: ../LICENSE
    dst: /usr/share/doc/unmask-plugin-nginx/LICENSE
    type: license
    packager: rpm
  - src: ../LICENSE
    dst: /usr/share/doc/unmask-plugin-nginx/LICENSE
    packager: deb
  - src: ../LICENSE
    dst: /usr/share/doc/unmask-plugin-nginx/LICENSE
    packager: apk
  - src: ../NOTICE
    dst: /usr/share/doc/unmask-plugin-nginx/NOTICE
  - src: ../THIRD-PARTY-NOTICES.md
    dst: /usr/share/doc/unmask-plugin-nginx/THIRD-PARTY-NOTICES.md
  - src: ./conf/copyright
    dst: /usr/share/doc/unmask-plugin-nginx/copyright
    packager: deb
