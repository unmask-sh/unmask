# web-caddy-body.yaml.in — body for unmask-web-caddy (= drops the Caddy v2
# web-integration snippet into /etc/caddy/conf.d/).
#
# Caddy v2 has a native forward_auth directive, so it works just by rewriting the
# example.com block in this file to the user's own domain.

description: |
  Caddy v2 web integration for unmask.
  Drops a Caddyfile fragment in /etc/caddy/conf.d/ so /unmask/admin/,
  /unmask/challenge/ and the forward_auth gateway are reachable.
  After install, edit the host name in the snippet, reload caddy and open
  https://your-host/unmask/admin/.

# caddy is only packaged in distro repos on Alpine (= community).  RHEL
# BaseOS/AppStream/EPEL and Debian main / Ubuntu universe do NOT ship caddy,
# so a hard `depends: caddy` makes `dnf install unmask-web-caddy` /
# `apt install unmask-web-caddy` fail outright.  Depend on caddy only where the
# package manager can resolve it (= apk override); on rpm/deb install Caddy from
# its official repo first (https://caddyserver.com/docs/install).
depends:
  - unmask

overrides:
  apk:
    depends:
      - unmask
      - caddy

contents:
  - src: ../snippets/Caddyfile-forward-auth
    dst: /etc/caddy/conf.d/unmask-web.caddy
    type: config|noreplace
    file_info:
      mode: 0644

scripts:
  postinstall: ./scripts/postinstall-web-caddy.sh
  postremove:  ./scripts/postremove-web-caddy.sh
