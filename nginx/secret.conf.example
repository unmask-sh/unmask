# /etc/unmask/nginx/secret.conf — admin app と同じ secret を設定する.
#
# postinstall script で /etc/unmask/config.yml の secret.bv_secret から
# 自動生成される. 手動で書く場合は `unmask-admin config-init` で生成された
# config.yml の値とこの値を一致させること.
#
# 漏洩した場合は両方 (= ここと config.yml) を新しい値に変えて、 admin と nginx を
# 同時 reload すること. cookie は invalidate される.

unmask_bv_secret      "REPLACE_WITH_RANDOM_SECRET";
unmask_bv_valid_days  3;
