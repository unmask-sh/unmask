ngx_addon_name=ngx_http_unmask_module

# ja4_parser.c は OpenSSL 非依存の pure-C ClientHello parser.
# SSL_CTX_set_msg_callback (= OpenSSL 0.9.7+ 全 ABI 共通) 経由で渡る raw bytes を
# 解釈し、 OpenSSL 1.0 / 1.1 / 3.x / LibreSSL / BoringSSL 全環境で 1 source build を可能にする.

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_unmask_module
    ngx_module_srcs="$ngx_addon_dir/src/ngx_http_unmask_module.c $ngx_addon_dir/src/ja4_parser.c"
    ngx_module_libs="-lcrypto"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_unmask_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/src/ngx_http_unmask_module.c $ngx_addon_dir/src/ja4_parser.c"
    CORE_LIBS="$CORE_LIBS -lcrypto"
fi
